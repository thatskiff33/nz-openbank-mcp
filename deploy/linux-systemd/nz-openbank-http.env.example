# Placeholder-only environment loaded only by nz-openbank-http.service.
# Copy to /etc/nz-openbank-mcp/nz-openbank-http.env (root:root 0600) and fill
# values on the host. The tunnel unit never loads this file.

# Streamable HTTP MCP ingress.
# OAuth is the public connector mode for ChatGPT and Claude web.
NZ_OPENBANK_MCP_AUTH_MODE=oauth
NZ_OPENBANK_MCP_HTTP_HOST=127.0.0.1
NZ_OPENBANK_MCP_HTTP_PORT=8091
NZ_OPENBANK_MCP_HTTP_PATH=/mcp
# Host and Origin headers are always checked. Loopback and, in OAuth mode, the
# host of NZ_OPENBANK_MCP_PUBLIC_BASE_URL are accepted. In bearer mode behind
# Caddy, set the public host name here or requests get HTTP 421.
# NZ_OPENBANK_MCP_ALLOWED_HOSTS=mcp.example.com

# Public base URL excludes the /mcp transport path.
NZ_OPENBANK_MCP_GOOGLE_CLIENT_ID=
NZ_OPENBANK_MCP_GOOGLE_CLIENT_SECRET=
NZ_OPENBANK_MCP_PUBLIC_BASE_URL=https://mcp.example.com/openbank-mcp
NZ_OPENBANK_MCP_ALLOWED_USERS=
# Primary Google Workspace domains only; matched against the hd claim.
NZ_OPENBANK_MCP_ALLOWED_DOMAINS=
# Required in OAuth mode: at least 32 bytes (`openssl rand -base64 48`).
# Signs connector tokens and encrypts client registrations.
NZ_OPENBANK_MCP_JWT_SIGNING_KEY=
# Optional: comma-separated client redirect URI patterns. Defaults to the
# Claude, ChatGPT and Cursor agent callbacks plus http://localhost:* and http://127.0.0.1:*.
# https entries must use an exact path with no wildcards.
# NZ_OPENBANK_MCP_ALLOWED_REDIRECT_URIS=
# NZ_OPENBANK_MCP_STATE_DIR is set by nz-openbank-http.service.

# Legacy bearer mode remains available for approved clients that cannot use
# OAuth. Leave empty when NZ_OPENBANK_MCP_AUTH_MODE=oauth. In bearer mode the
# token must be at least 32 visible ASCII characters (`openssl rand -base64 48`).
NZ_OPENBANK_MCP_BEARER_TOKEN=
