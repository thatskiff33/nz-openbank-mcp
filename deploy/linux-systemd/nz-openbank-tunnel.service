[Unit]
Description=OpenAI Secure MCP Tunnel for nz-openbank-mcp
Documentation=https://github.com/thatskiff33/nz-openbank-mcp/tree/main/deploy/linux-systemd
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=nz-openbank-mcp
Group=nz-openbank-mcp
WorkingDirectory=/opt/nz-openbank-mcp
EnvironmentFile=/etc/nz-openbank-mcp/nz-openbank.env
Environment=UV_CACHE_DIR=/var/lib/nz-openbank-mcp/uv-cache
Environment=XDG_CACHE_HOME=/var/lib/nz-openbank-mcp/cache
ExecStart=/usr/local/bin/tunnel-client run --profile nz-openbank --profile-dir /etc/tunnel-client/profiles --health.listen-addr 127.0.0.1:8080 --health.url-file /run/nz-openbank-mcp/tunnel-health.url
Restart=on-failure
RestartSec=5s
RuntimeDirectory=nz-openbank-mcp
RuntimeDirectoryMode=0750
StateDirectory=nz-openbank-mcp
StateDirectoryMode=0750
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ReadWritePaths=/run/nz-openbank-mcp /var/lib/nz-openbank-mcp
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
