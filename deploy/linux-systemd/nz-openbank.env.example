# Placeholder-only environment for nz-openbank-tunnel.service.
# Copy to /etc/nz-openbank-mcp/nz-openbank.env and fill values on the host.

# OpenAI Secure MCP Tunnel runtime values.
# CONTROL_PLANE_API_KEY must be a Runtime API key with Tunnels Read + Use.
# Do not put an OpenAI Admin API key in this file.
CONTROL_PLANE_TUNNEL_ID=REPLACE_WITH_OPENAI_TUNNEL_ID
CONTROL_PLANE_API_KEY=REPLACE_WITH_OPENAI_RUNTIME_API_KEY

# Akahu Personal App credentials.
AKAHU_APP_TOKEN=REPLACE_WITH_AKAHU_APP_TOKEN
AKAHU_USER_TOKEN=REPLACE_WITH_AKAHU_USER_TOKEN

# Akahu API and safety defaults. AKAHU_BASE_URL must stay on api.akahu.io;
# AKAHU_ALLOW_CUSTOM_BASE_URL is ignored when set in this file.
AKAHU_BASE_URL=https://api.akahu.io/v1
AKAHU_READ_ONLY=true
AKAHU_AUTOMATION_BYPASS=false
AKAHU_REQUEST_TIMEOUT=10
AKAHU_LOG_LEVEL=INFO

# Streamable HTTP MCP ingress. Required only for nz-openbank-http.service.
# OAuth is the public connector mode for ChatGPT and Claude web.
NZ_OPENBANK_MCP_AUTH_MODE=oauth
NZ_OPENBANK_MCP_HTTP_HOST=127.0.0.1
NZ_OPENBANK_MCP_HTTP_PORT=8091
NZ_OPENBANK_MCP_HTTP_PATH=/mcp

# Public base URL excludes the /mcp transport path.
NZ_OPENBANK_MCP_GOOGLE_CLIENT_ID=
NZ_OPENBANK_MCP_GOOGLE_CLIENT_SECRET=
NZ_OPENBANK_MCP_PUBLIC_BASE_URL=https://mcp.example.com/openbank-mcp
NZ_OPENBANK_MCP_ALLOWED_USERS=
NZ_OPENBANK_MCP_ALLOWED_DOMAINS=

# Legacy bearer mode remains available for approved clients that cannot use
# OAuth. Leave empty when NZ_OPENBANK_MCP_AUTH_MODE=oauth. In bearer mode the
# token must be at least 32 characters (`openssl rand -base64 48`).
NZ_OPENBANK_MCP_BEARER_TOKEN=

# tunnel-client logging. Health/admin binding is fixed by the systemd unit.
LOG_LEVEL=info
LOG_FORMAT=json
