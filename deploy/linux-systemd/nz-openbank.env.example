# Placeholder-only environment shared by nz-openbank-tunnel.service and
# nz-openbank-http.service. HTTP-only secrets live in nz-openbank-http.env.
# Copy to /etc/nz-openbank-mcp/nz-openbank.env and fill values on the host.

# OpenAI Secure MCP Tunnel runtime values.
# CONTROL_PLANE_API_KEY must be a Runtime API key with Tunnels Read + Use.
# Do not put an OpenAI Admin API key in this file.
CONTROL_PLANE_TUNNEL_ID=REPLACE_WITH_OPENAI_TUNNEL_ID
CONTROL_PLANE_API_KEY=REPLACE_WITH_OPENAI_RUNTIME_API_KEY

# Akahu Personal App credentials.
AKAHU_APP_TOKEN=REPLACE_WITH_AKAHU_APP_TOKEN
AKAHU_USER_TOKEN=REPLACE_WITH_AKAHU_USER_TOKEN

# Akahu API and safety defaults. AKAHU_BASE_URL must stay on api.akahu.io;
# AKAHU_ALLOW_CUSTOM_BASE_URL is ignored when set in this file.
AKAHU_BASE_URL=https://api.akahu.io/v1
AKAHU_READ_ONLY=true
AKAHU_AUTOMATION_BYPASS=false
AKAHU_MASK_ACCOUNTS=false
AKAHU_REQUEST_TIMEOUT=10
AKAHU_LOG_LEVEL=INFO

# tunnel-client logging. Health/admin binding is fixed by the systemd unit.
LOG_LEVEL=info
LOG_FORMAT=json
