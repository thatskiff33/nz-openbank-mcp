{
  "name": "nz-openbank-mcp",
  "version": "0.1.4",
  "description": "Unofficial MCP server for the Akahu open-finance API (NZ). 14 tools, read-only by default, runs locally over stdio.",
  "author": {
    "name": "thatskiff33",
    "email": "258212727+thatskiff33@users.noreply.github.com"
  },
  "homepage": "https://github.com/thatskiff33/nz-openbank-mcp",
  "repository": "https://github.com/thatskiff33/nz-openbank-mcp",
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "akahu",
    "open-finance",
    "new-zealand",
    "banking"
  ],
  "category": "finance",
  "logo": "assets/logo.png",
  "variables": {
    "type": "object",
    "properties": {
      "AKAHU_USER_TOKEN": {
        "type": "string",
        "title": "Akahu User Token",
        "description": "User token from https://my.akahu.nz/developers."
      },
      "AKAHU_APP_TOKEN": {
        "type": "string",
        "title": "Akahu App Token",
        "description": "App token from https://my.akahu.nz/developers."
      },
      "AKAHU_READ_ONLY": {
        "type": "string",
        "title": "Read-only mode",
        "description": "Refuse all write tools when 'true'. Leave as 'true' unless you specifically need refresh/verify/report writes.",
        "default": "true"
      },
      "AKAHU_AUTOMATION_BYPASS": {
        "type": "string",
        "title": "Automation bypass",
        "description": "Skip per-call consent prompts for safe-to-automate writes (account refresh only). Requires read-only=false.",
        "default": "false"
      }
    },
    "required": [
      "AKAHU_USER_TOKEN",
      "AKAHU_APP_TOKEN"
    ]
  },
  "mcpServers": {
    "akahu": {
      "command": "uvx",
      "args": [
        "--from",
        "nz-openbank-mcp==0.1.4",
        "nz-openbank-mcp"
      ],
      "env": {
        "AKAHU_USER_TOKEN": "${AKAHU_USER_TOKEN:-}",
        "AKAHU_APP_TOKEN": "${AKAHU_APP_TOKEN:-}",
        "AKAHU_READ_ONLY": "${AKAHU_READ_ONLY:-true}",
        "AKAHU_AUTOMATION_BYPASS": "${AKAHU_AUTOMATION_BYPASS:-false}"
      }
    }
  }
}
