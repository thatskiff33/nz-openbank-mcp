# The server never reads a .env file from the working directory. To load
# this file, copy it outside the repository, fill it in, and point the server
# at it with an absolute path in the real environment:
#   AKAHU_ENV_FILE=/abs/path/to/nz-openbank.env nz-openbank-mcp
# On Linux and macOS the file must not be writable by group or others
# (chmod 600 is a good default).
# Variables set in the process environment win over values in the file.

# Akahu credentials. Get yours from https://my.akahu.nz/developers
# Required: both tokens.
AKAHU_APP_TOKEN=app_token_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AKAHU_USER_TOKEN=user_token_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Akahu API base URL. Must be on https://api.akahu.io unless
# AKAHU_ALLOW_CUSTOM_BASE_URL=true is set in the real process environment
# (that flag is ignored when it appears in an env file).
AKAHU_BASE_URL=https://api.akahu.io/v1

# SAFETY: read-only mode is on by default. Every write tool refuses with a
# clear error until you flip this to false.
AKAHU_READ_ONLY=true

# SAFETY: per-call elicitation bypass for the *automatable* subset of writes.
#
# What this does:
#   When AKAHU_READ_ONLY=false, every write tool asks Claude to confirm with
#   you before it fires (an "elicitation prompt"). Setting this flag to true
#   skips that prompt -- but only for tools whose decorator explicitly
#   declared automatable=True.
#
# Why a separate subset:
#   A write is only marked automatable=True if it satisfies ALL four:
#     1. Idempotent or naturally rate-limited
#     2. No third-party side effects (no humans notified, no money moved,
#        no identity records changed)
#     3. Easily reversed or self-corrects next cycle
#     4. Has a common automation use case (e.g. nightly refresh)
#
# Which tools that subset currently contains:
#   - accounts/refresh_all_accounts
#   - accounts/refresh_account
#
# Which tools are NOT bypassable and will ALWAYS elicit:
#   - transactions/report_transaction_issue (sends a ticket to Akahu staff)
#   - identity/verify_name (identity check, may incur per-call charge)
#
# Logging:
#   Every bypassed call logs at INFO with the tool name. On startup, the
#   server prints a banner enumerating the bypass-eligible tools so the
#   current safety posture is always visible.
#
# Recommendation:
#   Leave this false for ad-hoc Claude conversations. Only set true if you
#   are running an unattended automation that needs to call refresh on a
#   schedule.
AKAHU_AUTOMATION_BYPASS=false

# Account numbers are shown in full by default. Set true to show only the
# bank code, last four digits and suffix. Transaction descriptions are never
# masked and can include account numbers.
AKAHU_MASK_ACCOUNTS=false

# HTTP timeout for Akahu API calls (seconds).
AKAHU_REQUEST_TIMEOUT=10

# Log verbosity: DEBUG, INFO, WARNING, ERROR or CRITICAL (case-insensitive).
# API response bodies and tokens are never logged.
AKAHU_LOG_LEVEL=INFO

# Streamable HTTP MCP ingress. Bearer mode is the default and preserves
# existing HTTP clients that send Authorization: Bearer <token>. The bearer
# token must be at least 32 visible ASCII characters; generate one with
# `openssl rand -base64 48`.
NZ_OPENBANK_MCP_AUTH_MODE=bearer
NZ_OPENBANK_MCP_BEARER_TOKEN=
NZ_OPENBANK_MCP_HTTP_HOST=127.0.0.1
NZ_OPENBANK_MCP_HTTP_PORT=8091
NZ_OPENBANK_MCP_HTTP_PATH=/mcp
# Host and Origin headers are always checked. Loopback is accepted; OAuth mode
# also accepts the host of NZ_OPENBANK_MCP_PUBLIC_BASE_URL. Behind a reverse
# proxy in bearer mode, list the public host here (host or host:port, comma
# separated) or requests get HTTP 421. Ports are not checked against Host.
NZ_OPENBANK_MCP_ALLOWED_HOSTS=

# OAuth mode is the recommended public connector mode for ChatGPT and Claude web.
# Public base URL excludes the /mcp transport path.
NZ_OPENBANK_MCP_GOOGLE_CLIENT_ID=
NZ_OPENBANK_MCP_GOOGLE_CLIENT_SECRET=
NZ_OPENBANK_MCP_PUBLIC_BASE_URL=https://mcp.example.com/openbank-mcp
NZ_OPENBANK_MCP_ALLOWED_USERS=
# Primary Google Workspace domains only; matched against the hd claim.
NZ_OPENBANK_MCP_ALLOWED_DOMAINS=
# Required in OAuth mode: signing key of at least 32 bytes and 10 distinct characters
# (`openssl rand -base64 48`) and an absolute state directory.
NZ_OPENBANK_MCP_JWT_SIGNING_KEY=
NZ_OPENBANK_MCP_STATE_DIR=
# Optional: comma-separated client redirect URI patterns (https, or http on
# loopback). Defaults to the Claude, ChatGPT and Cursor agent callbacks plus localhost.
# NZ_OPENBANK_MCP_ALLOWED_REDIRECT_URIS=
